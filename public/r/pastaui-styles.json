{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "pastaui-styles",
  "title": "Pasta UI Styles",
  "description": "Shared card shadow, surface shadow and heading/label utilities used across Pasta UI components.",
  "cssVars": {
    "theme": {
      "shadow-card": "var(--card-shadow)",
      "shadow-linear-surface": "var(--linear-surface-shadow)"
    },
    "light": {
      "card-outline": "lch(0 0 0 / 8.8%)",
      "card-shadow": "0 0 0 0.5px var(--card-outline), 0 3px 6px -2px lch(0 0 0 / 2%), 0 1px 1px 0 lch(0 0 0 / 4%)",
      "linear-surface-shadow": "0 3px 6px -2px lch(0 0 0 / 2%), 0 1px 1px 0 lch(0 0 0 / 4%)"
    },
    "dark": {
      "card-outline": "lch(100 0 0 / 8.8%)"
    }
  },
  "css": {
    "@utility card-heading": {
      "font-family": "var(--font-sans)",
      "font-size": "15px",
      "font-weight": "500",
      "letter-spacing": "-0.05px"
    },
    "@utility metadata-label": {
      "font-family": "var(--font-sans)",
      "font-size": "12px",
      "font-weight": "450",
      "line-height": "20px",
      "letter-spacing": "-0.05px",
      "color": "var(--muted-foreground)"
    }
  },
  "type": "registry:item"
}
{
  "name": "pastaui",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "build": "vite build",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check",
    "dev": "vite dev --port 3000",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "generate-routes": "tsr generate",
    "lint": "oxlint --type-aware --react-plugin --jsx-a11y-plugin --import-plugin --ignore-pattern src/routeTree.gen.ts .",
    "lint:fix": "pnpm lint --fix",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@solar-icons/react": "^2.2.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "motion": "^13.4.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@iconify-json/simple-icons": "^1.2.96",
    "@iconify-json/solar": "^1.2.11",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^6.0.2",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.0.0"
  },
  "packageManager": "pnpm@12.0.0"
}
